# ─── Public site URL (metadata, sitemap, JSON-LD) ───────────────────────────
# Production canonical host (no trailing slash, no www):
#   https://ashine.si
# www.ashine.si redirects here. Use this exact URL in Google Search Console (or a Domain property).
# Wrong value (*.vercel.app) makes sitemap/OG point at preview URLs - fix on Vercel.
# NEXT_PUBLIC_SITE_URL=https://ashine.si

# ─── Contact email (footer, legal pages, JSON-LD, booking fallback) ─────────
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# ─── Google Maps (service area map) ─────────────────────────────────────────
# In Google Cloud Console enable at least:
#   - Maps JavaScript API
#   - Geocoding API (used to place the marker from the address string)
# Restrict the key by HTTP referrer (Application restrictions → HTTP referrers).
# Add ALL of these if you use www + non-www:
#   https://ashine.si/*
#   https://www.ashine.si/*
#   https://*.vercel.app/*          (optional, for preview deploys)
#   http://localhost:3000/*
# Enable APIs: Maps JavaScript API + Geocoding API. Billing must be on.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_key_here

# Map ID - required for AdvancedMarkerElement. Create in Cloud Console → Map Management
# → Map IDs (type: JavaScript; Raster or Vector both work). The site uses raster
# rendering in code so maps still work when WebGL is blocked. If unset, uses
# DEMO_MAP_ID (dev only; set your own Map ID for production).
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_map_id_here

# ─── Google reviews (home page testimonials) ───────────────────────────────
# 1. Enable "Places API (New)" in Google Cloud (same project as Maps).
# 2. Create a SECOND API key for the server:
#    - API restrictions: Places API (New) only
#    - Application restrictions: None (not HTTP referrers — Vercel has no referrer)
# 3. Place ID is ChIJ… (NOT a share.google link). Find it:
#    https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
# GOOGLE_PLACE_ID=ChIJxxxxxxxx
# GOOGLE_MAPS_API_KEY=your_server_key_here
# Keep NEXT_PUBLIC_GOOGLE_MAPS_API_KEY as the browser key (Maps JS + Geocoding + referrers).

# ─── Resend (legacy /api/booking route only) ────────────────────────────────
# The live form sends mail through the booking API, not through this app.
# These variables matter only if that older route is called.
# https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=A-Shine <bookings@ashine.si>
# BOOKING_TO_EMAIL=info.ashine@gmail.com

# ─── Booking calendar API (AShineBookingAPI) ────────────────────────────────
# The contact form calls this for free days, free times, and booking submit.
# Local: http://localhost:8080
# Production: https://api.ashine.si  (no trailing slash)
# NEXT_PUBLIC_BOOKING_API_URL=http://localhost:8080
