# ─── Public site URL (metadata, sitemap, JSON-LD) ───────────────────────────
# Production (no trailing slash): https://ashine.si
# Wrong value (*.vercel.app) makes sitemap/OG point at preview URLs — fix on Vercel.
# NEXT_PUBLIC_SITE_URL=https://ashine.si

# ─── Contact email (footer, legal pages, JSON-LD, booking fallback) ─────────
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# ─── Google Maps (service area map) ─────────────────────────────────────────
# In Google Cloud Console enable at least:
#   - Maps JavaScript API
#   - Geocoding API (used to place the marker from the address string)
# Restrict the key by HTTP referrer (Application restrictions → HTTP referrers).
# Add ALL of these if you use www + non-www:
#   https://ashine.si/*
#   https://www.ashine.si/*
#   https://*.vercel.app/*          (optional, for preview deploys)
#   http://localhost:3000/*
# Enable APIs: Maps JavaScript API + Geocoding API. Billing must be on.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_key_here

# Map ID — required for AdvancedMarkerElement. Create in Cloud Console → Map Management
# → Map IDs (type: JavaScript; Raster or Vector both work). The site uses raster
# rendering in code so maps still work when WebGL is blocked. If unset, uses
# DEMO_MAP_ID (dev only; set your own Map ID for production).
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_map_id_here

# ─── Resend (booking form emails) ────────────────────────────────────────────
# https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx

# Production sender (requires verified domain — see below):
# RESEND_FROM=AShine <bookings@ashine.si>

# Domain verification (required before bookings@ashine.si works):
#   1. https://resend.com/domains → Add domain → ashine.si
#   2. Add the DNS records Resend shows (DKIM, SPF, etc.) at your DNS host
#      (where ashine.si is registered — e.g. GoDaddy, Cloudflare, Namecheap).
#   3. Wait until Resend shows "Verified" (often minutes, sometimes up to 48h).
#   4. Redeploy on Vercel with the same RESEND_* vars.
# Until verified, Resend returns 403 and the booking form will fail.
#
# Vercel (required for production bookings — set for Production, then Redeploy):
#   RESEND_API_KEY, RESEND_FROM, BOOKING_TO_EMAIL, NEXT_PUBLIC_CONTACT_EMAIL
#
# Local-only workaround (limited): comment out RESEND_FROM or set:
#   RESEND_FROM=onboarding@resend.dev
# Resend then only delivers to the email on your Resend account, not customers.

# Inbox for new booking notifications (confirmation still goes to form email).
# BOOKING_TO_EMAIL=info.ashine@gmail.com
