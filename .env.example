# ─── Public site URL (metadata, sitemap, JSON-LD) ───────────────────────────
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Contact email (footer, legal pages, JSON-LD, booking fallback) ─────────
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# ─── Google Maps (service area map) ─────────────────────────────────────────
# In Google Cloud Console enable at least:
#   - Maps JavaScript API
#   - Geocoding API (used to place the marker from the address string)
# Restrict the key by HTTP referrer to your production domain (and localhost for dev).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_key_here

# Map ID — required for the modern AdvancedMarkerElement (replaces deprecated Marker).
# Create one in Google Cloud Console → Map Management → Map IDs (type: JavaScript,
# vector recommended). You can configure cloud-based map styling there. If unset,
# the component falls back to Google's public "DEMO_MAP_ID" — fine for local dev
# but rate-limited and not customizable; set your own for production.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_map_id_here

# ─── Resend (booking form emails) ────────────────────────────────────────────
# https://resend.com — create an API key and add your sending domain (or use
# onboarding@resend.dev for tests per Resend docs).
# RESEND_API_KEY=re_xxxxxxxx

# Optional verified sender (default in code: Resend onboarding address).
# RESEND_FROM=AShine Bookings <bookings@yourdomain.com>

# Optional: inbox for owner notifications (defaults to NEXT_PUBLIC_CONTACT_EMAIL).
# BOOKING_TO_EMAIL=owner@example.com
